{
  "name": "oxiquill-workspace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.2.2",
  "license": "AGPL-3.0-only",
  "overrides": {
    "vite": "7.3.3"
  },
  "scripts": {
    "dev": "pnpm --dir examples/docs-site dev",
    "dev:astro": "pnpm --dir examples/docs-site dev:astro",
    "dev:runtime": "pnpm --dir examples/docs-site dev:runtime",
    "build": "pnpm --dir examples/docs-site build",
    "preview": "pnpm --dir examples/docs-site preview",
    "docgen": "pnpm --dir examples/docs-site docgen",
    "wasm:dev": "pnpm --dir examples/docs-site wasm:dev",
    "wasm:build": "pnpm --dir examples/docs-site wasm:build",
    "check": "pnpm --dir examples/docs-site check",
    "test": "pnpm test:coverage && pnpm doc:rust && pnpm test:wasm && pnpm build && pnpm test:e2e",
    "test:coverage": "pnpm test:rust:coverage && pnpm test:unit:coverage",
    "test:rust": "pnpm --dir examples/docs-site test:rust",
    "test:rust:coverage": "pnpm --dir examples/docs-site test:rust:coverage",
    "test:unit": "vitest run",
    "test:unit:coverage": "vitest run --coverage",
    "doc:rust": "pnpm --dir examples/docs-site doc:rust",
    "test:wasm": "pnpm --dir examples/docs-site test:wasm",
    "test:e2e": "playwright test",
    "lint:rust": "pnpm --dir examples/docs-site lint:rust",
    "clean": "pnpm --dir examples/docs-site clean"
  },
  "devDependencies": {
    "@playwright/test": "1.60.0",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/preact": "3.2.4",
    "@vitest/coverage-v8": "4.1.7",
    "jsdom": "29.1.1",
    "preact": "10.29.2",
    "typescript": "6.0.3",
    "vite": "7.3.3",
    "vitest": "4.1.7"
  }
}
