{
  "name": "oxiquill",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.1",
  "license": "AGPL-3.0-only",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:astro": "astro dev",
    "dev:runtime": "node scripts/watch-doc-runtime.mjs",
    "build": "pnpm wasm:build && astro check && astro build",
    "preview": "astro preview",
    "docgen": "node scripts/generate-doc-runtime.mjs",
    "wasm:dev": "node scripts/generate-doc-runtime.mjs --wasm dev",
    "wasm:build": "node scripts/generate-doc-runtime.mjs --wasm build",
    "check": "pnpm wasm:dev && astro check",
    "test": "pnpm test:coverage && pnpm doc:rust && pnpm test:wasm && pnpm build && pnpm test:e2e",
    "test:coverage": "pnpm test:rust:coverage && pnpm test:unit:coverage",
    "test:rust": "node scripts/run-helper-cargo.mjs test",
    "test:rust:coverage": "node scripts/run-helper-cargo.mjs llvm-cov --fail-under-lines 100 --fail-under-functions 100 --fail-under-regions 100 --ignore-filename-regex '(/target/|/src/generated/)'",
    "test:unit": "vitest run",
    "test:unit:coverage": "vitest run --coverage",
    "doc:rust": "RUSTDOCFLAGS=\"-D warnings\" node scripts/run-helper-cargo.mjs doc --no-deps",
    "test:wasm": "pnpm wasm:dev && wasm-pack test --node src/generated/doc-runtime/rust-cells",
    "test:e2e": "playwright test",
    "lint:rust": "node scripts/run-helper-cargo.mjs clippy --all-targets -- -D warnings",
    "clean": "node scripts/clean.mjs"
  },
  "dependencies": {
    "@astrojs/preact": "latest",
    "@astrojs/starlight": "latest",
    "astro": "latest",
    "echarts": "latest",
    "katex": "^0.17.0",
    "mermaid": "^11.15.0",
    "preact": "latest",
    "pyodide": "^0.29.4",
    "rehype-katex": "^7.0.1",
    "remark-math": "^6.0.0",
    "shiki": "^4.1.0",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@astrojs/check": "latest",
    "@playwright/test": "latest",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/preact": "^3.2.4",
    "@vitest/coverage-v8": "^4.1.7",
    "chokidar": "^5.0.0",
    "jsdom": "^29.1.1",
    "typescript": "latest",
    "vite": "7.3.3",
    "vitest": "^4.1.7"
  }
}
