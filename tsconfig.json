{
    "extends": "astro/tsconfigs/strict",
    "compilerOptions": {
        "jsx": "react-jsx",
        "jsxImportSource": "preact",
        "types": [
            "vite/client"
        ]
    },
    "include": [
        ".astro/types.d.ts",
        "src/**/*",
        "tests/**/*",
        "playwright.config.ts"
    ],
    "exclude": [
        "dist",
        "node_modules",
        "target"
    ]
}
