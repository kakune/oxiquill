---
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="robots" content="noindex" />
    <title>Page Not Found | Oxiquill</title>
    <style>
      :root {
        color-scheme: light dark;
        font-family: system-ui, sans-serif;
      }

      body {
        display: grid;
        min-height: 100vh;
        margin: 0;
        place-items: center;
        background: light-dark(#f8fafc, #0f172a);
        color: light-dark(#111827, #f8fafc);
      }

      main {
        width: min(36rem, calc(100% - 3rem));
      }

      p {
        line-height: 1.7;
      }

      ul {
        display: grid;
        gap: 0.75rem;
        padding-inline-start: 1.25rem;
      }

      a {
        color: light-dark(#0f766e, #67e8f9);
      }

      a:focus-visible {
        outline: 0.2rem solid currentColor;
        outline-offset: 0.2rem;
      }
    </style>
  </head>
  <body>
    <main>
      <p>404</p>
      <h1>Page Not Found</h1>
      <p>The requested page may have moved or the URL may be incorrect.</p>
      <ul>
        <li><a href={base}>Go to the English documentation home</a></li>
        <li><a href={`${base}ja/`}>日本語ドキュメントのトップへ</a></li>
        <li><a href={`${base}guides/troubleshooting/`}>Open troubleshooting</a></li>
      </ul>
    </main>
  </body>
</html>
