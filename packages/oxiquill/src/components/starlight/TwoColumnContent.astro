---
import ArrowIcon from './ArrowIcon.astro';
import { togglePresentation } from './toggle-localization.js';

const { dir, entry, lang, toc } = Astro.locals.starlightRoute;
const presentation = togglePresentation(lang, dir, 'tableOfContents');
const hasTableOfContents = Boolean(toc);
const contentWidth = (entry.data as { contentWidth?: unknown }).contentWidth === 'full' ? 'full' : undefined;
---

<script is:inline define:vars={{ hasTableOfContents }}>
  (() => {
    let collapsed = false;
    try {
      collapsed =
        hasTableOfContents &&
        matchMedia('(min-width: 72rem)').matches &&
        sessionStorage.getItem('oxiquill-table-of-contents-collapsed') === 'true';
    } catch {}
    document.documentElement.toggleAttribute('data-table-of-contents-collapsed', collapsed);
  })();
</script>

<div class="two-column-content lg:sl-flex" data-content-width={contentWidth}>
  {toc && (
    <>
      <aside id="starlight__right-sidebar" class="right-sidebar-container print:hidden">
        <div class="right-sidebar">
          <slot name="right-sidebar" />
        </div>
      </aside>
      <starlight-table-of-contents-toggle
        class="print:hidden"
        data-collapse-label={presentation.collapseLabel}
        data-expand-label={presentation.expandLabel}
      >
        <button
          type="button"
          class="table-of-contents-toggle-button sl-flex"
          aria-controls="starlight__right-sidebar"
          aria-expanded="true"
          aria-label={presentation.collapseLabel}
          title={presentation.collapseLabel}
        >
          <span class="collapse-table-of-contents" aria-hidden="true">
            <ArrowIcon name={presentation.collapseIcon} />
          </span>
          <span class="expand-table-of-contents" aria-hidden="true">
            <ArrowIcon name={presentation.expandIcon} />
          </span>
        </button>
      </starlight-table-of-contents-toggle>
    </>
  )}
  <div class="main-pane">
    <slot />
  </div>
</div>

<script>
  import { defineStarlightTableOfContentsToggle } from './table-of-contents-toggle.js';

  defineStarlightTableOfContentsToggle();
</script>

<style>
  :global(:root) {
    --oq-base-content-width: var(--sl-content-width);
    /* Consumers set --oq-toc-width; the default narrows the column on smaller desktops. */
    --oq-resolved-toc-width: var(--oq-toc-width, clamp(14rem, 18vw, var(--sl-sidebar-width)));
  }

  .two-column-content {
    --sl-content-width: calc(
      var(--oq-base-content-width) + var(--oq-released-sidebar-width, 0rem) +
        var(--oq-released-table-of-contents-width, 0rem)
    );
  }

  .two-column-content[data-content-width='full'] {
    --oq-base-content-width: 100%;
  }

  @media (min-width: 72rem) {
    :global([data-has-toc][data-table-of-contents-collapsed]) {
      --oq-released-table-of-contents-width: var(--oq-resolved-toc-width);
    }

    /* Starlight sizes the table of contents from a share of the viewport; use the column width instead. */
    .right-sidebar :global(.right-sidebar-panel) {
      overflow-wrap: anywhere;
    }

    .right-sidebar :global(.right-sidebar-panel > .sl-container) {
      width: calc(var(--oq-resolved-toc-width) - 2 * var(--sl-sidebar-pad-x));
      max-width: none;
    }
  }
</style>

<style>
  @layer starlight.core {
    .main-pane {
      min-inline-size: 0;
      isolation: isolate;
    }

    starlight-table-of-contents-toggle {
      display: none;
    }

    .table-of-contents-toggle-button {
      align-items: center;
      justify-content: center;
      border: 1px solid var(--sl-color-hairline-shade);
      border-radius: 50%;
      width: 2rem;
      height: 2rem;
      padding: 0;
      background-color: var(--sl-color-bg-nav);
      color: var(--sl-color-text);
      box-shadow: var(--sl-shadow-sm);
      cursor: pointer;
    }

    .table-of-contents-toggle-button:hover {
      border-color: var(--sl-color-gray-4);
      background-color: var(--sl-color-gray-6);
    }

    .table-of-contents-toggle-button:focus-visible {
      outline: 2px solid var(--sl-color-accent);
      outline-offset: 2px;
    }

    .table-of-contents-toggle-button[aria-expanded='true'] .expand-table-of-contents,
    .table-of-contents-toggle-button[aria-expanded='false'] .collapse-table-of-contents {
      display: none;
    }

    @media (min-width: 72rem) {
      .right-sidebar-container {
        order: 2;
        position: relative;
        width: max(
          var(--oq-resolved-toc-width),
          calc(var(--oq-resolved-toc-width) + (100% - var(--sl-content-width) - var(--oq-resolved-toc-width)) / 2)
        );
      }

      .right-sidebar {
        position: fixed;
        top: 0;
        border-inline-start: 1px solid var(--sl-color-hairline);
        padding-top: var(--sl-nav-height);
        width: 100%;
        height: 100vh;
        overflow-y: auto;
        scrollbar-width: none;
      }

      .main-pane {
        width: 100%;
      }

      :global([data-has-sidebar][data-has-toc]) .main-pane {
        --sl-content-margin-inline: auto 0;

        order: 1;
        width: min(
          calc(100% - var(--oq-resolved-toc-width)),
          calc(var(--sl-content-width) + (100% - var(--sl-content-width) - var(--oq-resolved-toc-width)) / 2)
        );
      }

      starlight-table-of-contents-toggle {
        display: block;
      }

      .table-of-contents-toggle-button {
        position: fixed;
        z-index: var(--sl-z-index-navbar);
        inset-block-start: calc(var(--sl-nav-height) + 0.75rem);
        /*
         * Straddle the border of the table-of-contents column. The fixed containing block spans the
         * viewport, so subtracting the sidebar inset reproduces the width this column is sized from.
         */
        inset-inline-end: calc(
          max(
              var(--oq-resolved-toc-width),
              calc(
                var(--oq-resolved-toc-width) +
                  (
                    100% - var(--sl-content-inline-start, 0rem) - var(--sl-content-width) - var(--oq-resolved-toc-width)
                  ) /
                  2
              )
            ) -
            1rem
        );
        transition:
          background-color 0.15s ease,
          border-color 0.15s ease,
          inset-inline-end 0.15s ease;
      }

      :global([data-table-of-contents-collapsed]) .right-sidebar-container {
        display: none;
      }

      :global([data-has-toc][data-table-of-contents-collapsed]) .main-pane {
        --sl-content-margin-inline: auto;

        width: 100%;
      }

      :global([data-table-of-contents-collapsed]) .table-of-contents-toggle-button {
        inset-inline-end: var(--sl-nav-pad-x);
      }
    }

    @media (prefers-reduced-motion: reduce) {
      .table-of-contents-toggle-button {
        transition: none;
      }
    }
  }
</style>
