{
  "name": "oxiquill",
  "version": "0.3.1",
  "description": "Interactive Astro/Starlight notes with Rust, Python, math, Mermaid, WebAssembly, and Pyodide",
  "author": "kakune",
  "private": false,
  "type": "module",
  "packageManager": "pnpm@11.2.2",
  "license": "MIT OR Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kakune/oxiquill.git",
    "directory": "packages/oxiquill"
  },
  "homepage": "https://kakune.github.io/oxiquill/",
  "bugs": {
    "url": "https://github.com/kakune/oxiquill/issues"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "clean": "node ./scripts/clean-dist.mjs",
    "build": "pnpm run clean && tsc --project tsconfig.build.json && node ./scripts/copy-package-assets.mjs",
    "prepack": "pnpm run build"
  },
  "types": "./dist/index.d.ts",
  "bin": {
    "oxiquill": "./dist/cli/index.mjs"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./astro": {
      "types": "./dist/astro/index.d.ts",
      "import": "./dist/astro/index.js",
      "default": "./dist/astro/index.js"
    },
    "./content": {
      "types": "./dist/content/index.d.ts",
      "import": "./dist/content/index.js",
      "default": "./dist/content/index.js"
    },
    "./runtime/InteractiveCell": {
      "types": "./dist/components/doc-runtime/InteractiveCell.d.ts",
      "import": "./dist/components/doc-runtime/InteractiveCell.js",
      "default": "./dist/components/doc-runtime/InteractiveCell.js"
    },
    "./runtime/MermaidDiagram": {
      "types": "./dist/components/doc-runtime/MermaidDiagram.d.ts",
      "import": "./dist/components/doc-runtime/MermaidDiagram.js",
      "default": "./dist/components/doc-runtime/MermaidDiagram.js"
    },
    "./runtime/types": {
      "types": "./dist/lib/doc-runtime/types.d.ts",
      "import": "./dist/lib/doc-runtime/types.js",
      "default": "./dist/lib/doc-runtime/types.js"
    },
    "./components/starlight/PageFrame": "./dist/components/starlight/PageFrame.astro",
    "./components/starlight/TwoColumnContent": "./dist/components/starlight/TwoColumnContent.astro",
    "./styles/katex.css": "./dist/styles/katex.css",
    "./styles/custom.css": "./dist/styles/custom.css",
    "./tsconfigs/strict": "./dist/tsconfigs/strict.json",
    "./env": {
      "types": "./dist/env.d.ts"
    }
  },
  "files": [
    "LICENSE-APACHE",
    "LICENSE-MIT",
    "README.md",
    "dist"
  ],
  "keywords": [
    "astro",
    "astro-integration",
    "documentation",
    "haskell",
    "mermaid",
    "pyodide",
    "python",
    "rust",
    "starlight",
    "webassembly"
  ],
  "dependencies": {
    "@astrojs/check": "0.9.10",
    "@astrojs/markdown-remark": "7.2.4",
    "@astrojs/preact": "6.0.4",
    "@astrojs/starlight": "0.41.9",
    "@bjorn3/browser_wasi_shim": "0.4.2",
    "astro": "7.2.9",
    "chokidar": "5.0.0",
    "echarts": "6.1.0",
    "katex": "0.16.47",
    "mermaid": "11.17.2",
    "preact": "10.29.8",
    "pyodide": "314.0.6",
    "rehype-katex": "7.0.1",
    "remark-math": "6.0.0",
    "remark-mdx": "3.1.1",
    "remark-parse": "11.0.0",
    "shiki": "4.4.3",
    "smol-toml": "1.8.0",
    "typescript": "6.0.3",
    "unified": "11.0.5",
    "vite": "8.2.2",
    "yaml": "2.9.0"
  }
}
