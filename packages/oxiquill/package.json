{
  "name": "oxiquill",
  "version": "0.2.0",
  "private": false,
  "type": "module",
  "license": "MIT OR Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kakune/oxiquill.git",
    "directory": "packages/oxiquill"
  },
  "homepage": "https://kakune.github.io/oxiquill/",
  "bugs": {
    "url": "https://github.com/kakune/oxiquill/issues"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "registry": "https://registry.npmjs.org/"
  },
  "bin": {
    "oxiquill": "./src/cli/index.mjs"
  },
  "exports": {
    ".": "./src/index.mjs",
    "./astro": {
      "types": "./src/astro/index.d.ts",
      "import": "./src/astro/index.ts",
      "default": "./src/astro/index.ts"
    },
    "./content": {
      "types": "./src/content/index.d.ts",
      "import": "./src/content/index.mjs",
      "default": "./src/content/index.mjs"
    },
    "./runtime/InteractiveCell": "./src/components/doc-runtime/InteractiveCell.tsx",
    "./runtime/MermaidDiagram": "./src/components/doc-runtime/MermaidDiagram.tsx",
    "./runtime/types": "./src/lib/doc-runtime/types.ts",
    "./components/starlight/PageFrame": "./src/components/starlight/PageFrame.astro",
    "./styles/katex.css": "./src/styles/katex.css",
    "./styles/custom.css": "./src/styles/custom.css",
    "./tsconfigs/strict": "./tsconfigs/strict.json",
    "./env": "./src/env.d.ts"
  },
  "files": [
    "LICENSE-APACHE",
    "LICENSE-MIT",
    "README.md",
    "src",
    "tsconfigs",
    "!src/**/AGENTS.md"
  ],
  "keywords": [
    "astro",
    "astro-integration",
    "documentation",
    "starlight"
  ],
  "dependencies": {
    "@astrojs/check": "0.9.10",
    "@astrojs/markdown-remark": "7.2.4",
    "@astrojs/preact": "6.0.4",
    "@astrojs/starlight": "0.41.9",
    "@bjorn3/browser_wasi_shim": "0.4.2",
    "astro": "7.2.9",
    "chokidar": "5.0.0",
    "echarts": "6.1.0",
    "katex": "0.18.4",
    "mermaid": "11.17.2",
    "preact": "10.29.8",
    "pyodide": "314.0.6",
    "rehype-katex": "7.0.1",
    "remark-math": "6.0.0",
    "remark-mdx": "3.1.1",
    "remark-parse": "11.0.0",
    "shiki": "4.4.3",
    "typescript": "7.0.2",
    "unified": "11.0.5",
    "vite": "8.2.2",
    "yaml": "2.9.0"
  }
}
